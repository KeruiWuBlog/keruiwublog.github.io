.tag-filter
  width 100%

// Mobile-only collapse toggle; hidden on desktop.
.tag-filter-toggle
  display none

.tag-filter-panel
  display flex
  flex-wrap wrap
  align-items center
  gap 0.5rem

.tag-filter-chip
  display inline-flex
  align-items center
  gap 0.45rem
  padding 0.4rem 0.85rem
  border 1px solid var(--shadow-color1)
  border-radius 999px
  background var(--secondary-color)
  color var(--secondary-text-color)
  font inherit
  font-size 0.85rem
  line-height 1
  cursor pointer
  box-shadow 0 2px 8px var(--shadow-color2)
  transition background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease

  &:hover
    color var(--text-color)
    border-color var(--secondary-text-color)
    transform translateY(-1px)

  &.is-active
    background var(--text-color)
    border-color var(--text-color)
    color var(--main-color)

    .tag-filter-chip-count
      background var(--main-color)
      color var(--text-color)

.tag-filter-chip-name
  white-space nowrap

.tag-filter-chip-count
  display inline-flex
  align-items center
  justify-content center
  min-width 1.2rem
  padding 0.05rem 0.35rem
  border-radius 999px
  background var(--main-color)
  color var(--secondary-text-color)
  font-size 0.7rem
  line-height 1.4
  transition background-color 0.25s ease, color 0.25s ease

.timeline-item.is-filtered-out,
.timeline-year-node.is-filtered-out
  display none

@media (max-width: 768px)
  .tag-filter
    position relative
    border 1px solid var(--shadow-color1)
    border-radius 1rem
    background var(--secondary-color)
    box-shadow 0 2px 8px var(--shadow-color2)
    overflow hidden

  .tag-filter-toggle
    display flex
    align-items center
    gap 0.5rem
    width 100%
    padding 0.75rem 1rem
    border 0
    background transparent
    color var(--text-color)
    font inherit
    font-size 0.9rem
    cursor pointer

  .tag-filter-toggle-label
    font-weight 600

  .tag-filter-toggle-current
    margin-left auto
    color var(--secondary-text-color)
    font-size 0.82rem
    white-space nowrap
    overflow hidden
    text-overflow ellipsis
    max-width 50%
    text-align right

  .tag-filter-toggle-icon
    flex-shrink 0
    color var(--secondary-text-color)
    transition transform 0.3s ease

  .tag-filter.is-open
    .tag-filter-toggle-icon
      transform rotate(180deg)

  .tag-filter-panel
    max-height 0
    padding 0 1rem
    overflow hidden
    transition max-height 0.35s ease, padding 0.35s ease

  .tag-filter.is-open .tag-filter-panel
    max-height 60vh
    padding 0 1rem 1rem
    overflow-y auto

  .tag-filter-chip
    font-size 0.8rem
    padding 0.4rem 0.75rem
