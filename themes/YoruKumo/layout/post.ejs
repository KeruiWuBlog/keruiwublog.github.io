<%- partial('_partial/header') %>
<%
  var articleContent = page.content || '';
  var tocItems = [];
  var slugCounts = {};
  var tocLabel = __('post.toc') || 'Contents';

  function escapeAttribute(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function decodeEntity(value) {
    var entities = {
      amp: '&',
      lt: '<',
      gt: '>',
      quot: '"',
      apos: "'",
      nbsp: ' '
    };

    return String(value).replace(/&(#x?[0-9a-fA-F]+|[a-zA-Z]+);/g, function(match, entity) {
      if (entity.charAt(0) === '#') {
        var isHex = entity.charAt(1).toLowerCase() === 'x';
        var code = parseInt(entity.slice(isHex ? 2 : 1), isHex ? 16 : 10);
        return Number.isFinite(code) ? String.fromCharCode(code) : match;
      }

      return Object.prototype.hasOwnProperty.call(entities, entity) ? entities[entity] : match;
    });
  }

  function plainHeadingText(html) {
    return decodeEntity(String(html)
      .replace(/<a\s+[^>]*class=["'][^"']*headerlink[^"']*["'][\s\S]*?<\/a>/gi, '')
      .replace(/<[^>]+>/g, '')
      .replace(/\s+/g, ' ')
      .trim());
  }

  function makeTocSlug(text) {
    var base = String(text)
      .trim()
      .toLowerCase()
      .replace(/&[a-z0-9#]+;/gi, '')
      .replace(/[^a-z0-9\u4e00-\u9fa5_-]+/g, '-')
      .replace(/^-+|-+$/g, '') || 'section';

    slugCounts[base] = (slugCounts[base] || 0) + 1;
    return slugCounts[base] === 1 ? base : base + '-' + slugCounts[base];
  }

  function renderToc(className) {
    return [
      '<nav class="post-toc ' + className + '" aria-label="' + escapeAttribute(tocLabel) + '">',
      '<div class="post-toc-title">' + escapeAttribute(tocLabel) + '</div>',
      '<ol class="post-toc-list">',
      tocItems.map(function(item) {
        return '<li class="post-toc-item post-toc-level-' + item.level + '">' +
          '<a class="post-toc-link" href="#' + escapeAttribute(item.id) + '">' +
          escapeAttribute(item.title) +
          '</a>' +
          '</li>';
      }).join(''),
      '</ol>',
      '</nav>'
    ].join('');
  }

  articleContent = articleContent.replace(/<h([1-4])([^>]*)>([\s\S]*?)<\/h\1>/gi, function(match, level, attrs, inner) {
    var title = plainHeadingText(inner);
    if (!title) return match;

    var headingAttrs = attrs || '';
    var idMatch = headingAttrs.match(/\sid=(["'])(.*?)\1/i);
    var id = idMatch ? decodeEntity(idMatch[2]) : makeTocSlug(title);

    if (!idMatch) {
      headingAttrs += ' id="' + escapeAttribute(id) + '"';
    }

    tocItems.push({
      level: Number(level),
      id: id,
      title: title
    });

    return '<h' + level + headingAttrs + '>' + inner + '</h' + level + '>';
  });

  var showToc = tocItems.length >= 3;
%>
<div class="post-page">
  <main class="post-container">
    <div class="post-layout<%= showToc ? ' has-toc' : '' %>">
    <article class="post-article">
      <header class="post-header">
        <h1 class="post-title"><%= page.title %></h1>
        <div class="post-meta">
          <div class="meta-item">
            <p class="post-time"><%=date(page.date, 'YYYY-MM-DD') %></p>
          </div>
          <% if (theme.counter && theme.counter.enable && theme.counter.post_views) { %>
          <div class="meta-item">
            <span id="counter_container_page_pv" class="post-views" data-counter-key="<%= page.translation_key || ('single:' + page.path) %>" style="display:none">
              <i class="fa fa-eye" aria-hidden="true"></i>
              <span id="counter_page_pv">···</span>
              <%= __('post.views') %>
            </span>
          </div>
          <% } %>
          <% if (page.categories && page.categories.length) { %>
          <!-- <p class="meta-item">
            <%- list_categories(page.categories, { show_count: false, class:
            'post-category', style: 'none' }) %>
          </p> -->
          <% } %> <% if (page.tags && page.tags.length) { %>
          <p class="meta-item">
            <%- list_tags(page.tags, { show_count: false, class: 'post-tag',
            style: 'none' }) %>
          </p>
          <% } %>
        </div>
        <%
          var languageSwitcher = theme.language_switcher || {};
          var languageLabels = languageSwitcher.labels || {};
          var languageOrder = languageSwitcher.order || [];
          var languageVersions = [];
          var activePath = page.path;

          function getLanguageCode(post) {
            return post.lang || post.language || '';
          }

          function getLanguageLabel(code) {
            if (!code) return 'Version';
            return languageLabels[code] || languageLabels[code.split('-')[0]] || code;
          }

          function languageRank(post) {
            var code = getLanguageCode(post);
            var exactIndex = languageOrder.indexOf(code);
            if (exactIndex !== -1) return exactIndex;
            var baseIndex = languageOrder.indexOf(code.split('-')[0]);
            return baseIndex !== -1 ? baseIndex : languageOrder.length + 1;
          }

          if (page.translation_key && site.posts) {
            site.posts.each(function(post) {
              if (post.translation_key === page.translation_key) {
                languageVersions.push(post);
              }
            });
            languageVersions.sort(function(a, b) {
              var rankDiff = languageRank(a) - languageRank(b);
              if (rankDiff !== 0) return rankDiff;
              return getLanguageLabel(getLanguageCode(a)).localeCompare(getLanguageLabel(getLanguageCode(b)));
            });
          }
        %>
        <% if (languageVersions.length > 1) { %>
        <nav class="post-language-switcher" aria-label="Post language versions">
          <div class="post-language-options">
            <% languageVersions.forEach(function(version) {
              var langCode = getLanguageCode(version);
              var langLabel = getLanguageLabel(langCode);
              var isActive = version.path === activePath;
            %>
            <% if (isActive) { %>
            <span class="post-language-option is-active" aria-current="page"><%= langLabel %></span>
            <% } else { %>
            <a class="post-language-option" href="<%- url_for(version.path) %>" hreflang="<%- langCode %>"><%= langLabel %></a>
            <% } %>
            <% }); %>
          </div>
        </nav>
        <% } %>
      </header>

      <% if (showToc) { %>
      <%- renderToc('post-toc-inline') %>
      <% } %>

      <div class="post-content"><%- articleContent %></div>

      <%
        // Navigate between ARTICLE GROUPS (one per translation_key), mirroring the
        // timeline, so the two language versions of an article share a single slot
        // and prev/next never jumps into a different language unnecessarily.
        function navGroupKey(post) {
          return post.translation_key || ('single:' + post.path);
        }
        function navDateValue(post) {
          return Number(date(post.date, 'YYYYMMDDHHmmss'));
        }

        // Build groups in site order, then sort by each group's newest date (desc).
        var navGroups = [];
        if (site.posts) {
          var navGroupMap = {};
          site.posts.each(function(post) {
            var key = navGroupKey(post);
            if (!navGroupMap[key]) {
              navGroupMap[key] = [];
              navGroups.push(navGroupMap[key]);
            }
            navGroupMap[key].push(post);
          });
        }
        function groupNewestDate(versions) {
          return versions.reduce(function(max, v) {
            return Math.max(max, navDateValue(v));
          }, navDateValue(versions[0]));
        }
        navGroups.sort(function(a, b) {
          return groupNewestDate(b) - groupNewestDate(a);
        });

        // Pick the version of a group matching the current page's language,
        // falling back to the group's preferred (lowest-rank) language.
        function pickVersion(versions) {
          if (!versions || !versions.length) return null;
          var current = getLanguageCode(page);
          for (var i = 0; i < versions.length; i++) {
            if (getLanguageCode(versions[i]) === current) return versions[i];
          }
          return versions.slice().sort(function(a, b) {
            return languageRank(a) - languageRank(b);
          })[0];
        }

        var currentKey = navGroupKey(page);
        var currentIndex = -1;
        for (var gi = 0; gi < navGroups.length; gi++) {
          if (navGroupKey(navGroups[gi][0]) === currentKey) { currentIndex = gi; break; }
        }

        // Newer article => 上一篇 (prev); older article => 下一篇 (next).
        var prevPost = currentIndex > 0 ? pickVersion(navGroups[currentIndex - 1]) : null;
        var nextPost = (currentIndex !== -1 && currentIndex < navGroups.length - 1)
          ? pickVersion(navGroups[currentIndex + 1]) : null;
      %>
      <footer class="post-footer">
        <div class="post-nav">
          <% if (prevPost) { %>
          <div class="post-nav-prev">
            <i class="fa fa-chevron-left"></i>
            <a href="<%- url_for(prevPost.path) %>" rel="prev">
              <%= prevPost.title %>
            </a>
          </div>
          <% } else { %>
          <div class="post-nav-prev"></div>
          <% } %> <% if (nextPost) { %>
          <div class="post-nav-next">
            <a href="<%- url_for(nextPost.path) %>" rel="next">
              <%= nextPost.title %>
            </a>
            <i class="fa fa-chevron-right"></i>
          </div>
          <% } %>
        </div>
      </footer>
    </article>
    <% if (showToc) { %>
    <%- renderToc('post-toc-sidebar') %>
    <% } %>
    </div>
  </main>

  <%- partial('_partial/pagination', { page: page }) %>
</div>
